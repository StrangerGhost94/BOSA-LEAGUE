# PostgreSQL connection (Railway provides this automatically when you link the Postgres service)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/bosa"

# Long random string used to sign login sessions (generate with: openssl rand -base64 48)
AUTH_SECRET="change-me-to-a-long-random-string"

# Public URL of the site (used for Pesapal callbacks)
APP_URL="http://localhost:3000"

# Pesapal API 3.0 - get keys at https://developer.pesapal.com
# PESAPAL_ENV = sandbox | live
PESAPAL_ENV="sandbox"
PESAPAL_CONSUMER_KEY=""
PESAPAL_CONSUMER_SECRET=""
# Optional: set after the first payment registers your IPN (the app registers one automatically and caches it)
PESAPAL_IPN_ID=""

# When Pesapal keys are empty and this is "true", a "simulate payment" button appears (for local testing only)
PAYMENTS_DEMO_MODE="true"

# Password given to the demo accounts created by the first seed (change it, then change each account's password after first sign-in)
SEED_PASSWORD="Bosa@2026"
